# Default to Git text detection and normalized repository line endings.
* text=auto

# Windows-oriented C# and PowerShell source files.
*.cs      text eol=crlf
*.csx     text eol=crlf
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.psd1    text eol=crlf

# Documentation and repository configuration.
*.md            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.config        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Immutable evidence: preserve supplied bytes exactly. Disable text/encoding
# conversion and any configured clean/smudge or ident transformations.
reference/original-workloads/** -text -eol -working-tree-encoding -filter -ident -diff -merge
reference/proven-pocs/**         -text -eol -working-tree-encoding -filter -ident -diff -merge
